<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         COD Delivery Label 100 x 80 mm
         Values come from report/cod_label_report.py -> labels: list of dicts built by
         stock.picking._kh_get_label_values() (one dict per parcel). Texts are already truncated
         to the width of their box and font sizes are chosen in Python (kh_label_text.py).

         Renderer notes (wkhtmltopdf 0.12.6, old Qt WebKit):
           * no flexbox / grid / CSS variables; fixed-layout tables, absolute mm heights,
             overflow:hidden boxes as a safety net;
           * black and white only (no grey: thermal printers dither it), borders >= 0.3 mm,
             fonts >= 6 pt; Khmer glyphs come from the Khmer fonts of the fallback stack;
           * one div.article per label: every label is rendered as its own document, i.e. its
             own page (N labels -> N pages, never a trailing blank page). The style sheet is
             inside the article so each document is self-contained.
         Avoid the CSS classes "header", "footer" and "article" inside the label: Odoo moves
         such divs out of the page body.

         Vertical budget (inner height 76.2 mm = 77 mm - 2 x 0.4 mm border), each section height
         includes its 0.3 mm bottom rule:
           header 11 | receiver 25.7 | payment 22.1 | items 9.6 | footer 7.8
         ================================================================ -->

    <template id="report_cod_label_style">
        <style>
            html, body {
                margin: 0 !important;
                padding: 0 !important;
                width: auto !important;
                max-width: none !important;
                height: auto !important;
                min-height: 0 !important;
                background: #fff !important;
            }
            .o_kh_page {
                margin: 0;
                padding: 1.5mm 0 0 1.5mm;
                page-break-inside: avoid;
            }
            .o_kh_label, .o_kh_label * {
                -webkit-box-sizing: border-box;
                box-sizing: border-box;
            }
            .o_kh_label {
                position: relative;
                width: 97mm;
                height: 77mm;
                overflow: hidden;
                border: 0.4mm solid #000;
                background: #fff;
                color: #000;
                font-family: Arial, 'Liberation Sans', 'DejaVu Sans', 'Khmer OS Battambang', 'Khmer OS Siemreap', 'Noto Sans Khmer', 'Khmer OS', sans-serif;
                font-size: 8pt;
                line-height: 1.2;
                text-align: left;
                word-wrap: break-word;
            }
            .o_kh_label table {
                width: 100%;
                table-layout: fixed;
                border-collapse: collapse;
                border-spacing: 0;
                margin: 0;
                color: #000;
                background: transparent;
                font-size: inherit;
            }
            /* Bootstrap (report CSS bundle) gives table rows / sections "border-style: solid;
               border-width: 0": in the collapsed border model wkhtmltopdf draws them as grey
               hairlines, so they are reset here (cell borders are only set by .o_kh_sep). */
            .o_kh_label table, .o_kh_label thead, .o_kh_label tbody, .o_kh_label tfoot, .o_kh_label tr {
                border: 0 none !important;
            }
            .o_kh_label td {
                padding: 0;
                vertical-align: top;
                overflow: hidden;
                border: 0 none;
            }
            .o_kh_label img { display: block; border: 0; }
            .o_kh_nowrap { white-space: nowrap; overflow: hidden; }
            .o_kh_center { text-align: center; }
            .o_kh_right { text-align: right; }
            .o_kh_middle { vertical-align: middle !important; }
            .o_kh_sep { border-left: 0.3mm solid #000 !important; }
            .o_kh_pad { padding: 0.4mm 1.6mm !important; }

            /* sections */
            .o_kh_sec { position: relative; overflow: hidden; border-bottom: 0.3mm solid #000; }
            .o_kh_sec_head { height: 11mm; }
            .o_kh_sec_head table.o_kh_cols { height: 10.7mm; }
            .o_kh_sec_recv { height: 25.7mm; }
            .o_kh_sec_recv table.o_kh_cols { height: 25.4mm; }
            .o_kh_sec_pay { height: 22.1mm; }
            .o_kh_sec_pay table.o_kh_cols { height: 21.8mm; }
            .o_kh_sec_items { height: 9.6mm; }
            .o_kh_sec_items table.o_kh_cols { height: 9.3mm; }
            .o_kh_sec_foot { height: 7.8mm; border-bottom: 0; }
            .o_kh_sec_foot table.o_kh_cols { height: 7.8mm; }

            /* 1. header */
            .o_kh_logo_cell { width: 11mm; }
            .o_kh_logo { max-width: 10mm; max-height: 9.6mm; }
            .o_kh_company { font-size: 9pt; font-weight: bold; line-height: 1.15; height: 3.7mm; white-space: nowrap; overflow: hidden; }
            .o_kh_tagline { font-size: 6pt; line-height: 1.3; height: 2.8mm; white-space: nowrap; overflow: hidden; }
            .o_kh_cphone { font-size: 7.5pt; font-weight: bold; line-height: 1.2; white-space: nowrap; overflow: hidden; }
            .o_kh_ref { font-size: 8.5pt; font-weight: bold; line-height: 1.2; white-space: nowrap; overflow: hidden; }
            .o_kh_meta { font-size: 6.5pt; line-height: 1.3; white-space: nowrap; overflow: hidden; }
            .o_kh_courier { font-size: 7pt; font-weight: bold; line-height: 1.25; height: 3.1mm; white-space: nowrap; overflow: hidden; }
            .o_kh_parcel_label { font-size: 6pt; line-height: 1.3; white-space: nowrap; overflow: hidden; }
            .o_kh_parcel_line { line-height: 1.1; white-space: nowrap; overflow: hidden; }
            .o_kh_parcel { font-size: 10pt; font-weight: bold; }
            .o_kh_weight { font-size: 6.5pt; }

            /* 2. receiver */
            .o_kh_recv_cell { padding: 0.5mm 1.6mm 0.2mm 1.6mm !important; }
            .o_kh_tag { font-size: 6pt; font-weight: bold; line-height: 1.25; height: 2.65mm; white-space: nowrap; overflow: hidden; }
            .o_kh_name { font-weight: bold; line-height: 1.15; height: 5.3mm; white-space: nowrap; overflow: hidden; }
            .o_kh_phone { font-weight: bold; line-height: 1.0; height: 6.5mm; padding-top: 0.2mm; white-space: nowrap; overflow: hidden; }
            .o_kh_phone_icon { font-size: 11pt; }
            .o_kh_phone2_line { font-size: 10pt; font-weight: bold; line-height: 1.15; height: 3.9mm; white-space: nowrap; overflow: hidden; }
            .o_kh_blank { display: inline-block; border-bottom: 0.3mm solid #000; height: 4mm; vertical-align: baseline; }
            .o_kh_address { font-size: 8pt; line-height: 1.2; height: 10.2mm; overflow: hidden; }
            .o_kh_address_2 { height: 6.8mm; }
            .o_kh_address_blank { font-size: 7pt; line-height: 1.6; height: 10.2mm; overflow: hidden; }
            .o_kh_province_cell { width: 27.5mm; padding: 1mm 1.2mm 1mm 0 !important; }
            .o_kh_with_info .o_kh_province_cell { width: 24mm; padding-right: 0 !important; }
            .o_kh_province_box { border: 0.5mm solid #000; }
            .o_kh_province_box table { height: 22.4mm; }
            .o_kh_province_label { font-size: 6pt; font-weight: bold; line-height: 1.3; white-space: nowrap; overflow: hidden; }
            .o_kh_province_prefix { font-size: 7.5pt; font-weight: bold; line-height: 1.3; }
            .o_kh_province_name { font-weight: bold; line-height: 1.3; padding: 0 0.25mm; overflow: hidden; }
            .o_kh_info_cell { width: 18.5mm; padding: 1.5mm 1.5mm 0 1.5mm !important; text-align: center; }
            .o_kh_info_cell .o_kh_qr { width: 14.5mm; height: 14.5mm; margin: 0 auto; }

            /* 3. payment */
            .o_kh_pay_cod { background: #000 !important; color: #fff !important; padding: 0.6mm 2mm !important; vertical-align: middle !important; }
            .o_kh_pay_cod * { color: #fff !important; }
            .o_kh_pay_title { font-size: 8pt; font-weight: bold; line-height: 1.3; white-space: nowrap; overflow: hidden; }
            .o_kh_amount_line { white-space: nowrap; overflow: hidden; line-height: 1.05; }
            .o_kh_amount { font-weight: bold; }
            .o_kh_secondary { font-size: 12pt; font-weight: bold; padding-left: 2mm; }
            .o_kh_breakdown { font-size: 6.5pt; line-height: 1.3; white-space: nowrap; overflow: hidden; }
            .o_kh_multi { font-weight: bold; }
            .o_kh_pay_caption { font-size: 7pt; font-weight: bold; line-height: 1.3; white-space: nowrap; overflow: hidden; text-align: right; }
            .o_kh_pay_cell { padding: 1.4mm 1.6mm !important; }
            .o_kh_paid_box { border: 0.9mm solid #000; }
            .o_kh_paid_box table { height: 16.8mm; }
            .o_kh_paid_title { font-size: 15pt; font-weight: bold; line-height: 1.25; white-space: nowrap; }
            .o_kh_paid_sub { font-size: 8.5pt; font-weight: bold; line-height: 1.3; white-space: nowrap; }
            .o_kh_none_box { border: 0.3mm solid #000; }
            .o_kh_none_box table { height: 18mm; }
            .o_kh_none_title { font-size: 12pt; font-weight: bold; line-height: 1.3; white-space: nowrap; }
            .o_kh_none_sub { font-size: 7pt; line-height: 1.3; white-space: nowrap; }
            /* info QR of PAID / NO COD labels: 0.8 mm + 15 mm code + 0.5 mm + two 6 pt caption lines fit the 21.8 mm section */
            .o_kh_qr_cell { width: 25mm; padding: 0.8mm 1.5mm 0 1.5mm !important; text-align: center; }
            .o_kh_qr_cell .o_kh_qr { width: 15mm; height: 15mm; margin: 0 auto; }
            .o_kh_qr_caption { font-size: 6pt; line-height: 1.25; white-space: nowrap; overflow: hidden; text-align: center; padding-top: 0.5mm; }
            /* payment QR: the white cell is the quiet zone, also next to the black COD box. The 18 mm
               code is centred without padding (wkhtmltopdf rounds paddings to whole CSS pixels):
               ~2 mm left / right in the 22 mm cell, ~1.9 mm above / below in the 21.8 mm section */
            .o_kh_payqr_cell { width: 22mm; padding: 0 !important; background: #fff !important; text-align: center; vertical-align: middle !important; }
            .o_kh_payqr { width: 18mm; height: 18mm; margin: 0 auto; }
            .o_kh_payqr_img { max-width: 18mm; max-height: 18mm; margin: 0 auto; }

            /* 4. items and instructions */
            /* the items summary and the note share 3 lines; Python decides how many each gets
               (items_lines / note_lines) and fits the texts to them */
            .o_kh_items_cell { padding: 0.3mm 1.6mm 0 1.6mm !important; }
            .o_kh_items { font-size: 6.5pt; line-height: 1.25; overflow: hidden; }
            .o_kh_items.o_kh_lines_1 { max-height: 2.9mm; white-space: nowrap; }
            .o_kh_items.o_kh_lines_2 { max-height: 5.8mm; }
            .o_kh_items.o_kh_lines_3 { max-height: 8.7mm; }
            .o_kh_note { font-size: 7pt; line-height: 1.2; overflow: hidden; }
            .o_kh_note.o_kh_lines_1 { max-height: 3mm; white-space: nowrap; }
            .o_kh_note.o_kh_lines_2 { max-height: 6mm; }
            .o_kh_note.o_kh_lines_3 { max-height: 9mm; }
            .o_kh_chips_cell { width: 40mm; padding: 0.6mm 1.2mm 0 0 !important; }
            .o_kh_chip { border: 0.3mm solid #000; font-size: 6pt; font-weight: bold; line-height: 1.3; height: 3.8mm; padding: 0.3mm 0.8mm 0 0.8mm; margin-bottom: 0.5mm; white-space: nowrap; overflow: hidden; }
            .o_kh_chip_inv { background: #000 !important; color: #fff !important; }

            /* 5. footer */
            .o_kh_barcode_cell { width: 52mm; padding: 0.5mm 2.8mm 0 2.8mm !important; }
            .o_kh_barcode { width: 46mm; height: 4.6mm; }
            .o_kh_barcode_text { font-size: 6pt; font-weight: bold; line-height: 1.2; letter-spacing: 0.25mm; text-align: center; white-space: nowrap; overflow: hidden; }
            .o_kh_footer_text { font-size: 6pt; line-height: 1.3; max-height: 7.4mm; overflow: hidden; text-align: center; }
        </style>
    </template>

    <!-- 1. Header: sender | references | courier / parcel -->
    <template id="report_cod_label_head">
        <div class="o_kh_sec o_kh_sec_head">
            <table class="o_kh_cols"><tr>
                <td class="o_kh_pad o_kh_middle" style="width: 47mm;">
                    <table><tr>
                        <td t-if="label['logo']" class="o_kh_logo_cell o_kh_middle">
                            <img class="o_kh_logo" t-att-src="label['logo']" alt="Logo"/>
                        </td>
                        <td class="o_kh_middle">
                            <div class="o_kh_company" t-out="label['company_name']"/>
                            <div t-if="label['tagline']" class="o_kh_tagline" t-out="label['tagline']"/>
                            <div t-if="label['company_phone']" class="o_kh_cphone">&#9742; <t t-out="label['company_phone']"/></div>
                        </td>
                    </tr></table>
                </td>
                <td class="o_kh_pad o_kh_sep o_kh_middle" style="width: 25mm;">
                    <div class="o_kh_ref" t-out="label['reference']"/>
                    <div t-if="label['order_ref']" class="o_kh_meta" t-out="label['order_ref']"/>
                    <div t-if="label['date']" class="o_kh_meta" t-out="label['date']"/>
                </td>
                <td class="o_kh_pad o_kh_sep o_kh_middle o_kh_center">
                    <div t-if="label['courier']" class="o_kh_courier" t-out="label['courier']"/>
                    <div class="o_kh_parcel_label">កញ្ចប់ Parcel</div>
                    <div class="o_kh_parcel_line">
                        <span class="o_kh_parcel" t-out="label['parcel_label']"/>
                        <span t-if="label['weight']" class="o_kh_weight"> · <t t-out="label['weight']"/></span>
                    </div>
                </td>
            </tr></table>
        </div>
    </template>

    <!-- QR code with caption (info QR: map / reference) -->
    <template id="report_cod_label_info_qr">
        <img class="o_kh_qr" t-att-src="label['info_qr']" alt="QR"/>
        <div class="o_kh_qr_caption">
            <t t-foreach="label['info_qr_caption_lines']" t-as="caption_line">
                <t t-out="caption_line"/><br t-if="not caption_line_last"/>
            </t>
        </div>
    </template>

    <!-- 2. Receiver: name, phone, address | province box | info QR (when the payment QR takes its place) -->
    <template id="report_cod_label_receiver">
        <t t-set="info_here" t-value="label['info_qr'] and label['info_qr_place'] == 'receiver'"/>
        <div t-attf-class="o_kh_sec o_kh_sec_recv #{'o_kh_with_info' if info_here else ''}">
            <table class="o_kh_cols"><tr>
                <td class="o_kh_recv_cell">
                    <div class="o_kh_tag">អ្នកទទួល · TO</div>
                    <div class="o_kh_name" t-attf-style="font-size: #{label['name_size']}pt;" t-out="label['receiver_name']"/>
                    <div class="o_kh_phone" t-attf-style="font-size: #{label['phone_size']}pt;">
                        <span class="o_kh_phone_icon">&#9742;</span>
                        <t t-if="label['phones']">
                            <span t-out="label['phones'][0]"/>
                            <span t-if="len(label['phones']) &gt; 1 and not label['phone2_line']"
                                  t-attf-style="font-size: #{label['phone2_size']}pt;">/ <t t-out="label['phones'][1]"/></span>
                        </t>
                        <span t-else="" class="o_kh_blank" style="width: 40mm;"/>
                    </div>
                    <div t-if="label['phone2_line']" class="o_kh_phone2_line">&#9742; <t t-out="label['phones'][1]"/></div>
                    <div t-if="label['address']" t-attf-class="o_kh_address #{'o_kh_address_2' if label['phone2_line'] else ''}"
                         t-out="label['address']"/>
                    <div t-elif="not label['phone2_line']" class="o_kh_address_blank">
                        អាសយដ្ឋាន Address: <span class="o_kh_blank" style="width: 30mm;"/><br/>
                        <span class="o_kh_blank" style="width: 48mm;"/>
                    </div>
                </td>
                <td t-if="label['province']" class="o_kh_province_cell">
                    <div class="o_kh_province_box">
                        <table><tr><td class="o_kh_middle o_kh_center">
                            <div class="o_kh_province_label">ខេត្ត/ក្រុង PROVINCE</div>
                            <div t-if="label['province_prefix']" class="o_kh_province_prefix" t-out="label['province_prefix']"/>
                            <div class="o_kh_province_name" t-attf-style="font-size: #{label['province_size']}pt;"
                                 t-out="label['province_main']"/>
                        </td></tr></table>
                    </div>
                </td>
                <td t-if="info_here" class="o_kh_info_cell">
                    <t t-call="delivery_label_cod_kh.report_cod_label_info_qr"/>
                </td>
            </tr></table>
        </div>
    </template>

    <!-- 3. Payment: COD amount (black box) + payment QR / PAID / NO COD | info QR -->
    <template id="report_cod_label_payment">
        <t t-set="money" t-value="label['money']"/>
        <t t-set="pay_qr" t-value="label['pay_qr']"/>
        <div t-attf-class="o_kh_sec o_kh_sec_pay o_kh_state_#{money['state']}">
            <table class="o_kh_cols"><tr>
                <td t-if="money['state'] == 'cod'" class="o_kh_pay_cod">
                    <div class="o_kh_pay_title">COD · ប្រាក់ត្រូវប្រមូល</div>
                    <div class="o_kh_amount_line">
                        <span class="o_kh_amount" t-attf-style="font-size: #{money['amount_size']}pt;" t-out="money['amount_str']"/>
                        <span t-if="money['secondary_str']" class="o_kh_secondary" t-out="money['secondary_str']"/>
                    </div>
                    <div t-if="money['goods_str']" class="o_kh_breakdown">
                        ថ្លៃទំនិញ Goods <t t-out="money['goods_str']"/> + ថ្លៃដឹក Delivery <t t-out="money['fee_str']"/>
                    </div>
                    <div t-if="label['parcel_count'] &gt; 1" class="o_kh_breakdown o_kh_multi">
                        សរុប <t t-out="label['parcel_count']"/> កញ្ចប់ ប្រមូលតែម្តង · Total for <t t-out="label['parcel_count']"/> parcels, collect once
                    </div>
                    <div t-if="pay_qr" class="o_kh_pay_caption">
                        <t t-out="pay_qr['caption']"/> &#9654;
                    </div>
                </td>
                <td t-elif="money['state'] == 'paid'" class="o_kh_pay_cell">
                    <div class="o_kh_paid_box">
                        <table><tr><td class="o_kh_middle o_kh_center">
                            <div class="o_kh_paid_title">PAID · បានទូទាត់រួច</div>
                            <div class="o_kh_paid_sub">DO NOT COLLECT · មិនត្រូវប្រមូលប្រាក់</div>
                        </td></tr></table>
                    </div>
                </td>
                <td t-else="" class="o_kh_pay_cell">
                    <div class="o_kh_none_box">
                        <table><tr><td class="o_kh_middle o_kh_center">
                            <div class="o_kh_none_title">NO COD · មិនប្រមូលប្រាក់</div>
                            <div class="o_kh_none_sub">Nothing to collect</div>
                        </td></tr></table>
                    </div>
                </td>
                <td t-if="pay_qr" t-attf-class="o_kh_payqr_cell o_kh_payqr_#{pay_qr['mode']}">
                    <img t-if="pay_qr['mode'] == 'khqr_image'" class="o_kh_payqr_img" t-att-src="pay_qr['image']" alt="KHQR"/>
                    <img t-else="" class="o_kh_payqr" t-att-src="pay_qr['image']" alt="Pay QR"/>
                </td>
                <td t-elif="label['info_qr'] and label['info_qr_place'] == 'payment'" class="o_kh_qr_cell">
                    <t t-call="delivery_label_cod_kh.report_cod_label_info_qr"/>
                </td>
            </tr></table>
        </div>
    </template>

    <!-- 4. Items summary, note | handling chips -->
    <template id="report_cod_label_items">
        <div class="o_kh_sec o_kh_sec_items">
            <table class="o_kh_cols"><tr>
                <td class="o_kh_items_cell">
                    <div t-if="label['items_lines'] and (label['items'] or label['items_more'])"
                         t-attf-class="o_kh_items o_kh_lines_#{label['items_lines']}">
                        <b>ទំនិញ Items (ចំនួន Qty <t t-out="label['total_qty']"/>):</b>
                        <t t-if="label['items']">
                            <t t-out="label['items']"/><b t-if="label['items_more']"> … +<t t-out="label['items_more']"/> more</b>
                        </t>
                        <t t-else=""><t t-out="label['items_more']"/> មុខ products</t>
                    </div>
                    <div t-if="label['note']" t-attf-class="o_kh_note o_kh_lines_#{label['note_lines']}">
                        <b>ចំណាំ Note:</b> <t t-out="label['note']"/>
                    </div>
                </td>
                <td t-if="label['fragile'] or label['allow_check']" class="o_kh_chips_cell">
                    <div t-if="label['fragile']" class="o_kh_chip o_kh_chip_inv">&#9888; ប្រយ័ត្នបែក FRAGILE</div>
                    <div t-if="label['allow_check']" class="o_kh_chip">&#10003; អនុញ្ញាតឱ្យពិនិត្យទំនិញ Allow check</div>
                </td>
            </tr></table>
        </div>
    </template>

    <!-- 5. Footer: Code128 barcode of the transfer | thank-you text -->
    <template id="report_cod_label_foot">
        <div class="o_kh_sec o_kh_sec_foot">
            <table class="o_kh_cols"><tr>
                <td class="o_kh_barcode_cell">
                    <img t-if="label['barcode']" class="o_kh_barcode" t-att-src="label['barcode']" alt="Barcode"/>
                    <div class="o_kh_barcode_text" t-out="label['reference']"/>
                </td>
                <td class="o_kh_pad o_kh_middle">
                    <div t-if="label['footer']" class="o_kh_footer_text" t-out="label['footer']"/>
                </td>
            </tr></table>
        </div>
    </template>

    <!-- One label = one article = one 100 x 80 mm page -->
    <template id="report_cod_label_document">
        <div class="article o_kh_label_article" data-oe-model="stock.picking" t-att-data-oe-id="label['picking'].id">
            <t t-call="delivery_label_cod_kh.report_cod_label_style"/>
            <div class="page o_kh_page">
                <div class="o_kh_label" t-att-data-cod-state="label['money']['state']">
                    <t t-call="delivery_label_cod_kh.report_cod_label_head"/>
                    <t t-call="delivery_label_cod_kh.report_cod_label_receiver"/>
                    <t t-call="delivery_label_cod_kh.report_cod_label_payment"/>
                    <t t-call="delivery_label_cod_kh.report_cod_label_items"/>
