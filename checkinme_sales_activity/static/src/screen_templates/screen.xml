<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="checkinme_sales_activity.Screen">
        <div class="o_checkinme_screen">
            <div class="o_checkinme_screen_body">
                <header class="o_checkinme_topbar">
                    <button t-if="state.view !== 'home'" type="button" class="o_checkinme_topbar_btn" t-on-click="goHome" aria-label="Back">
                        <i class="fa fa-chevron-left"/>
                    </button>
                    <div class="o_checkinme_topbar_text">
                        <div class="o_checkinme_topbar_title" t-esc="title"/>
                        <div t-if="state.dashboard" class="o_checkinme_topbar_sub" t-esc="state.dashboard.employee.name"/>
                    </div>
                    <button t-if="state.view !== 'history'" type="button" class="o_checkinme_topbar_btn" t-on-click="openHistory" aria-label="My visits" title="My visits">
                        <i class="fa fa-history"/>
                    </button>
                    <button t-if="state.view !== 'settings'" type="button" class="o_checkinme_topbar_btn" t-on-click="openSettings" aria-label="App settings" title="App settings">
                        <i class="fa fa-cog"/>
                    </button>
                </header>
                <main class="o_checkinme_main">
                    <div t-if="state.loading" class="o_checkinme_loading"><i class="fa fa-spinner fa-spin fa-2x"/></div>
                    <t t-elif="!state.dashboard" >
                        <div class="o_checkinme_card text-danger">The screen could not be loaded. Please try again.</div>
                    </t>
                    <t t-elif="state.view === 'home'" t-call="checkinme_sales_activity.ScreenHome"/>
                    <t t-elif="state.view === 'checkin'" t-call="checkinme_sales_activity.ScreenCheckin"/>
                    <t t-elif="state.view === 'checkout'" t-call="checkinme_sales_activity.ScreenCheckout"/>
                    <t t-elif="state.view === 'result'" t-call="checkinme_sales_activity.ScreenResult"/>
                    <t t-elif="state.view === 'history'" t-call="checkinme_sales_activity.ScreenHistory"/>
                    <t t-elif="state.view === 'settings'" t-call="checkinme_sales_activity.ScreenSettings"/>
                </main>
            </div>
        </div>
    </t>

    <!-- ============================ HOME ============================ -->
    <t t-name="checkinme_sales_activity.ScreenHome">
        <t t-set="d" t-value="state.dashboard"/>
        <div t-if="showPushBanner" class="o_checkinme_card o_abj_banner">
            <i class="fa fa-bell o_abj_banner_icon"/>
            <div class="o_checkinme_list_main">Turn on notifications to get planned visits</div>
            <button type="button" class="btn btn-primary btn-sm o_checkinme_btn_md" t-on-click="enableNotifications" t-att-disabled="state.push.busy">Turn on</button>
            <button type="button" class="btn btn-link o_abj_banner_close" t-on-click="dismissPushBanner" aria-label="Dismiss" title="Dismiss"><i class="fa fa-times"/></button>
        </div>
        <div t-if="!d.employee.has_employee" class="o_checkinme_card o_checkinme_card_warning">
            <i class="fa fa-exclamation-triangle me-2"/>Your user is not linked to an employee. Ask your administrator to create your employee record before checking in.
        </div>

        <section class="o_checkinme_card">
            <div class="o_checkinme_card_title"><i class="fa fa-calendar-o me-2"/><t t-esc="d.today_label"/></div>
            <div class="o_checkinme_stats">
                <div class="o_checkinme_stat"><div class="o_checkinme_stat_value" t-esc="d.today_stats.visits"/><div class="o_checkinme_stat_label">Visits</div></div>
                <div class="o_checkinme_stat"><div class="o_checkinme_stat_value text-success" t-esc="d.today_stats.verified"/><div class="o_checkinme_stat_label">Verified</div></div>
                <div class="o_checkinme_stat"><div class="o_checkinme_stat_value" t-esc="d.today_stats.customers"/><div class="o_checkinme_stat_label">Customers</div></div>
                <div class="o_checkinme_stat"><div class="o_checkinme_stat_value" t-esc="d.today_stats.checkins"/><div class="o_checkinme_stat_label">Check-ins</div></div>
            </div>
        </section>

        <section t-if="d.open_visit" class="o_checkinme_card o_checkinme_card_open">
            <div class="o_checkinme_card_title"><span class="o_checkinme_dot"/>Checked in &#183; <t t-esc="openVisitElapsed"/></div>
            <div class="o_checkinme_visit_name" t-esc="d.open_visit.partner_name or d.open_visit.type_name"/>
            <div class="o_checkinme_muted">
                <i t-attf-class="fa {{ d.open_visit.type_icon }} me-1"/><t t-esc="d.open_visit.type_name"/>
                &#183; since <t t-esc="d.open_visit.checkin_time_local"/>
                <t t-if="d.open_visit.location_status === 'verified'"> &#183; <span class="text-success"><i class="fa fa-check-circle"/> on site</span></t>
                <t t-elif="d.open_visit.location_status === 'far'"> &#183; <span class="text-warning"><i class="fa fa-exclamation-circle"/> <t t-esc="formatDistance(d.open_visit.distance_to_partner)"/> away</span></t>
            </div>
            <div class="o_checkinme_row mt-3">
                <button type="button" class="btn btn-primary o_checkinme_btn_lg flex-grow-1" t-on-click="() => this.startCheckout(d.open_visit)"><i class="fa fa-flag-checkered me-2"/>Check Out</button>
                <button type="button" class="btn btn-outline-secondary o_checkinme_btn_lg" t-on-click="() => this.openRecord(d.open_visit.id)" aria-label="Edit in Odoo" title="Edit in Odoo"><i class="fa fa-pencil"/></button>
            </div>
        </section>

        <button type="button" t-attf-class="btn o_checkinme_btn_xl w-100 {{ d.open_visit ? 'btn-outline-primary' : 'btn-primary' }}"
                t-att-disabled="!d.employee.has_employee" t-on-click="() => this.startCheckin()">
            <i class="fa fa-map-marker me-2"/>Check In Now
        </button>

        <section t-if="d.target" class="o_checkinme_card">
            <div class="o_checkinme_card_title d-flex align-items-center">
                <span><i class="fa fa-bullseye me-2"/>This month</span>
                <span t-attf-class="o_checkinme_badge ms-auto o_checkinme_badge_{{ d.target.status }}" t-esc="d.target.status_label"/>
            </div>
            <div t-if="d.target.sales.target" class="o_checkinme_progress_row">
                <div class="d-flex justify-content-between"><span>Sales</span><span><t t-esc="d.target.sales.actual_display"/> / <t t-esc="d.target.sales.target_display"/></span></div>
                <div class="o_checkinme_progress"><div class="o_checkinme_progress_bar" t-attf-style="width: {{ pct(d.target.sales.pct) }}%"/></div>
            </div>
            <div t-if="d.target.visits.target" class="o_checkinme_progress_row">
                <div class="d-flex justify-content-between"><span>Visits</span><span><t t-esc="d.target.visits.actual"/> / <t t-esc="d.target.visits.target"/></span></div>
                <div class="o_checkinme_progress"><div class="o_checkinme_progress_bar" t-attf-style="width: {{ pct(d.target.visits.pct) }}%"/></div>
            </div>
            <div t-if="d.target.new_customers.target" class="o_checkinme_progress_row">
                <div class="d-flex justify-content-between"><span>New customers</span><span><t t-esc="d.target.new_customers.actual"/> / <t t-esc="d.target.new_customers.target"/></span></div>
                <div class="o_checkinme_progress"><div class="o_checkinme_progress_bar" t-attf-style="width: {{ pct(d.target.new_customers.pct) }}%"/></div>
            </div>
            <div t-if="d.target.orders.target" class="o_checkinme_progress_row">
                <div class="d-flex justify-content-between"><span>Orders</span><span><t t-esc="d.target.orders.actual"/> / <t t-esc="d.target.orders.target"/></span></div>
                <div class="o_checkinme_progress"><div class="o_checkinme_progress_bar" t-attf-style="width: {{ pct(d.target.orders.pct) }}%"/></div>
            </div>
            <div class="o_checkinme_muted mt-2"><t t-esc="d.target.days_remaining"/> days left &#183; expected <t t-esc="pct(d.target.expected_progress)"/>% by today</div>
        </section>

        <section t-if="d.planned_today.length" class="o_checkinme_card">
            <div class="o_checkinme_card_title"><i class="fa fa-list-ul me-2"/>Planned visits</div>
            <div t-foreach="d.planned_today" t-as="visit" t-key="visit.id" class="o_checkinme_list_item">
                <div class="o_checkinme_list_main">
                    <div class="o_checkinme_list_title" t-esc="visit.partner_name or visit.type_name"/>
                    <div class="o_checkinme_muted"><i t-attf-class="fa {{ visit.type_icon }} me-1"/><t t-esc="visit.type_name"/><t t-if="visit.purpose"> &#183; <t t-esc="visit.purpose"/></t></div>
                </div>
                <button type="button" class="btn btn-primary btn-sm o_checkinme_btn_md" t-on-click="() => this.startCheckin(visit)">Check In</button>
            </div>
        </section>

        <section t-if="followups.length" class="o_checkinme_card o_abj_followups">
            <div class="o_checkinme_card_title"><i class="fa fa-calendar-check-o me-2"/>Follow-ups today</div>
            <div t-foreach="followups" t-as="visit" t-key="visit.id" class="o_checkinme_list_item o_checkinme_clickable" t-on-click="() => this.openVisit(visit.id)">
                <div class="o_checkinme_list_main">
                    <div class="o_checkinme_list_title" t-esc="visit.partner_name or visit.type_name"/>
                    <div class="o_checkinme_muted">Last visit <t t-esc="visit.checkin_date_local"/><t t-if="visit.outcome_label"> &#183; <t t-esc="visit.outcome_label"/></t></div>
                </div>
                <button type="button" class="btn btn-primary btn-sm o_checkinme_btn_md" t-att-disabled="!d.employee.has_employee"
                        t-on-click.stop="() => this.startFollowUp(visit)">Check In</button>
            </div>
        </section>

        <section class="o_checkinme_card">
            <div class="o_checkinme_card_title"><i class="fa fa-check-square-o me-2"/>Today's visits</div>
            <div t-if="!d.today_visits.length" class="o_checkinme_muted">No visit yet today.</div>
            <div t-foreach="d.today_visits" t-as="visit" t-key="visit.id" class="o_checkinme_list_item o_checkinme_clickable" t-on-click="() => this.openVisit(visit.id)">
                <div class="o_checkinme_list_time" t-esc="visit.checkin_time_local"/>
                <div class="o_checkinme_list_main">
                    <div class="o_checkinme_list_title" t-esc="visit.partner_name or visit.type_name"/>
                    <div class="o_checkinme_muted"><t t-esc="visit.type_name"/><t t-if="visit.outcome_label"> &#183; <t t-esc="visit.outcome_label"/></t></div>
                    <span t-attf-class="o_checkinme_badge o_abj_row_badge o_checkinme_badge_{{ visit.location_status }}" t-esc="visit.location_status_label"/>
                </div>
                <i class="fa fa-chevron-right o_checkinme_muted"/>
            </div>
        </section>

        <div class="o_checkinme_footer">
            <a href="#" t-on-click.prevent="openFullApp">Open Sale Check in Odoo</a>
        </div>
    </t>

    <!-- ============================ CHECK-IN ============================ -->
    <t t-name="checkinme_sales_activity.ScreenCheckin">
        <t t-set="c" t-value="state.checkin"/>
        <ol class="o_checkinme_steps">
            <li t-attf-class="{{ c.step === 'location' ? 'active' : 'done' }}"><span>1</span>Location</li>
            <li t-attf-class="{{ c.step === 'customer' ? 'active' : (c.step === 'details' ? 'done' : '') }}"><span>2</span>Customer</li>
            <li t-attf-class="{{ c.step === 'details' ? 'active' : '' }}"><span>3</span>Details</li>
        </ol>

        <!-- Step 1: GPS -->
        <t t-if="c.step === 'location'">
            <section class="o_checkinme_card text-center">
                <t t-if="state.geo.status === 'locating'">
                    <div class="o_checkinme_geo_icon"><i class="fa fa-crosshairs fa-spin"/></div>
                    <div class="o_checkinme_visit_name">Getting your position...</div>
                    <div class="o_checkinme_muted">Stay still for a few seconds.</div>
                </t>
                <t t-elif="state.geo.status === 'ok'">
                    <div class="o_checkinme_geo_icon text-success"><i class="fa fa-map-marker"/></div>
                    <div class="o_checkinme_visit_name">Position captured</div>
                    <div class="o_checkinme_mono"><t t-esc="formatCoord(state.geo.latitude)"/>, <t t-esc="formatCoord(state.geo.longitude)"/></div>
                    <div class="o_checkinme_muted" t-if="state.geo.accuracy">Accuracy &#177;<t t-esc="state.geo.accuracy"/> m</div>
                </t>
                <t t-else="">
                    <div class="o_checkinme_geo_icon text-danger"><i class="fa fa-exclamation-triangle"/></div>
                    <div class="o_checkinme_visit_name">No GPS position</div>
                    <div class="o_checkinme_muted" t-esc="state.geo.error"/>
                </t>
                <button t-if="isNative and state.geo.denied" type="button" class="btn btn-outline-primary o_checkinme_btn_md w-100 mt-3" t-on-click="openAppSettings">
                    <i class="fa fa-cog me-2"/>Open app settings
                </button>
                <div class="o_checkinme_row mt-3">
                    <button type="button" class="btn btn-outline-secondary o_checkinme_btn_lg" t-on-click="captureGps" t-att-disabled="state.geo.status === 'locating'"><i class="fa fa-refresh me-2"/>Retry</button>
                    <button type="button" class="btn btn-primary o_checkinme_btn_lg flex-grow-1" t-on-click="continueFromLocation" t-att-disabled="state.geo.status === 'locating' or (requireGps and !hasPosition)">Continue<i class="fa fa-arrow-right ms-2"/></button>
                </div>
                <div t-if="requireGps" class="o_checkinme_muted mt-2">A GPS position is required to check in.</div>
            </section>
        </t>

        <!-- Step 2: customer -->
        <t t-if="c.step === 'customer'">
            <div class="o_checkinme_search">
                <i class="fa fa-search"/>
                <input type="search" class="form-control" placeholder="Search customer by name or phone" t-att-value="state.customerQuery" t-on-input="onCustomerInput" autofocus="autofocus"/>
            </div>
            <div class="o_checkinme_row mb-2">
                <button type="button" class="btn btn-outline-primary o_checkinme_btn_md flex-grow-1" t-on-click="toggleNewCustomer"><i class="fa fa-plus me-1"/>New customer</button>
                <button type="button" class="btn btn-link o_checkinme_btn_md" t-on-click="skipCustomer">No customer</button>
            </div>
            <section t-if="c.newCustomer.open" class="o_checkinme_card">
                <div class="o_checkinme_card_title">New customer</div>
                <input type="text" class="form-control mb-2" placeholder="Name *" t-model="state.checkin.newCustomer.name"/>
                <input type="tel" class="form-control mb-2" placeholder="Phone" t-model="state.checkin.newCustomer.phone"/>
                <input type="text" class="form-control mb-2" placeholder="Street" t-model="state.checkin.newCustomer.street"/>
                <input type="text" class="form-control mb-2" placeholder="City" t-model="state.checkin.newCustomer.city"/>
                <div class="o_checkinme_muted mb-2" t-if="hasPosition"><i class="fa fa-map-marker me-1"/>Your current position will be saved as the customer's location.</div>
                <button type="button" class="btn btn-primary o_checkinme_btn_lg w-100" t-on-click="createCustomer" t-att-disabled="state.busy">Create and select</button>
            </section>
            <div t-if="state.searching" class="o_checkinme_muted text-center py-2"><i class="fa fa-spinner fa-spin me-1"/>Searching...</div>
            <t t-foreach="customerSections" t-as="section" t-key="section.key">
                <div class="o_checkinme_section_label" t-esc="section.label"/>
                <div t-foreach="section.items" t-as="customer" t-key="customer.id" class="o_checkinme_list_item o_checkinme_clickable" t-on-click="() => this.selectCustomer(customer)">
                    <div class="o_checkinme_list_main">
                        <div class="o_checkinme_list_title" t-esc="customer.name"/>
                        <div class="o_checkinme_muted" t-if="customer.address" t-esc="customer.address"/>
                        <div class="o_checkinme_muted" t-if="customer.last_visit">Last visit <t t-esc="customer.last_visit"/></div>
                    </div>
                    <span t-if="customer.distance_m !== null and customer.distance_m !== undefined" class="o_checkinme_badge o_checkinme_badge_distance" t-esc="formatDistance(customer.distance_m)"/>
                    <i class="fa fa-chevron-right o_checkinme_muted ms-2"/>
                </div>
            </t>
            <div t-if="!state.searching and !customerSections.length" class="o_checkinme_muted text-center py-3">
                <t t-if="state.customerQuery">No customer found for "<t t-esc="state.customerQuery"/>".</t>
                <t t-else="">Type a name, or create the customer.</t>
            </div>
        </t>

        <!-- Step 3: details -->
        <t t-if="c.step === 'details'">
            <section class="o_checkinme_card">
                <div class="o_checkinme_list_item o_checkinme_clickable" t-on-click="() => this.goToStep('customer')">
                    <div class="o_checkinme_list_main">
                        <div class="o_checkinme_muted">Customer</div>
                        <div class="o_checkinme_list_title"><t t-if="c.partner" t-esc="c.partner.name"/><t t-else="">No customer</t></div>
                        <div class="o_checkinme_muted" t-if="c.partner and c.partner.address" t-esc="c.partner.address"/>
                    </div>
                    <span t-if="c.partner and c.partner.distance_m !== null and c.partner.distance_m !== undefined" class="o_checkinme_badge o_checkinme_badge_distance" t-esc="formatDistance(c.partner.distance_m)"/>
                    <i class="fa fa-pencil o_checkinme_muted ms-2"/>
                </div>
            </section>

            <div class="o_checkinme_section_label">Activity type</div>
            <div class="o_checkinme_tiles">
                <button t-foreach="state.dashboard.types" t-as="type" t-key="type.id" type="button"
                        t-attf-class="o_checkinme_tile {{ type.id === c.type_id ? 'active' : '' }}" t-on-click="() => this.chooseType(type)">
                    <i t-attf-class="fa {{ type.icon }}"/>
                    <span t-esc="type.name"/>
                </button>
            </div>

            <section class="o_checkinme_card">
                <label class="o_checkinme_label">Purpose</label>
                <input type="text" class="form-control mb-3" placeholder="e.g. Present the new price list" t-model="state.checkin.purpose"/>
                <label class="o_checkinme_label">Notes</label>
                <textarea class="form-control mb-3" rows="3" placeholder="What was discussed? Needs, objections, agreements..." t-model="state.checkin.notes"/>
                <label class="o_checkinme_label">Photo</label>
                <div t-if="c.photoPreview" class="o_checkinme_photo">
                    <img t-att-src="c.photoPreview" alt="Photo"/>
                    <button type="button" class="btn btn-sm btn-light" t-on-click="removePhoto" aria-label="Remove photo" title="Remove photo"><i class="fa fa-trash"/></button>
                </div>
                <label t-else="" class="btn btn-outline-secondary o_checkinme_btn_md w-100 mb-0">
                    <i class="fa fa-camera me-2"/>Take a photo
                    <input type="file" accept="image/*" capture="environment" class="d-none" t-on-change="onPhotoChange"/>
                </label>
            </section>

            <div class="o_checkinme_muted mb-2" t-if="hasPosition"><i class="fa fa-map-marker me-1"/>Position <t t-esc="formatCoord(state.geo.latitude)"/>, <t t-esc="formatCoord(state.geo.longitude)"/> (&#177;<t t-esc="state.geo.accuracy"/> m)</div>
            <button type="button" class="btn btn-primary o_checkinme_btn_xl w-100" t-on-click="submitCheckin" t-att-disabled="!canSubmitCheckin">
                <i t-if="state.busy" class="fa fa-spinner fa-spin me-2"/><i t-else="" class="fa fa-map-marker me-2"/>Check In
            </button>
        </t>
    </t>

    <!-- ============================ CHECK-OUT ============================ -->
    <t t-name="checkinme_sales_activity.ScreenCheckout">
        <t t-set="co" t-value="state.checkout"/>
        <section class="o_checkinme_card">
            <div class="o_checkinme_visit_name" t-esc="co.visit.partner_name or co.visit.type_name"/>
            <div class="o_checkinme_muted"><t t-esc="co.visit.name"/> &#183; <t t-esc="co.visit.type_name"/> &#183; since <t t-esc="co.visit.checkin_time_local"/></div>
            <div class="o_checkinme_muted mt-1">
                <t t-if="state.geo.status === 'locating'"><i class="fa fa-crosshairs fa-spin me-1"/>Capturing your position...</t>
                <t t-elif="state.geo.status === 'ok'"><i class="fa fa-map-marker me-1 text-success"/>Check-out position captured (&#177;<t t-esc="state.geo.accuracy"/> m)</t>
                <t t-else=""><i class="fa fa-exclamation-circle me-1 text-warning"/>No check-out position. <a href="#" t-on-click.prevent="captureGps">Retry</a></t>
            </div>
            <t t-if="state.geo.status === 'error' and state.geo.denied">
                <div class="o_checkinme_muted mt-1" t-esc="state.geo.error"/>
                <a t-if="isNative" href="#" class="d-block mt-1 o_abj_link_small" t-on-click.prevent="openAppSettings"><i class="fa fa-cog me-1"/>Open app settings</a>
            </t>
        </section>

        <div class="o_checkinme_section_label">Outcome</div>
        <div class="o_checkinme_tiles o_checkinme_tiles_outcome">
            <button t-foreach="state.dashboard.outcomes" t-as="outcome" t-key="outcome.value" type="button"
                    t-attf-class="o_checkinme_tile {{ outcome.value === co.outcome ? 'active' : '' }}" t-on-click="() => this.chooseOutcome(outcome.value)">
                <i t-attf-class="fa {{ outcome.value === 'order' ? 'fa-shopping-cart' : outcome.value === 'interested' ? 'fa-thumbs-o-up' : outcome.value === 'follow_up' ? 'fa-calendar-check-o' : outcome.value === 'not_interested' ? 'fa-thumbs-o-down' : 'fa-user-times' }}"/>
                <span t-esc="outcome.label"/>
            </button>
        </div>

        <section class="o_checkinme_card">
            <label class="o_checkinme_label">Sales amount (<t t-esc="state.dashboard.currency_symbol"/>)</label>
            <input type="number" inputmode="decimal" min="0" step="0.01" class="form-control mb-3" placeholder="0.00" t-model="state.checkout.sale_amount"/>
            <label class="o_checkinme_label">Follow-up date</label>
            <input type="date" class="form-control mb-3" t-model="state.checkout.next_action_date"/>
            <label class="o_checkinme_label">Notes</label>
            <textarea class="form-control" rows="3" placeholder="What was discussed? Needs, objections, agreements..." t-model="state.checkout.notes"/>
        </section>

        <button type="button" class="btn btn-primary o_checkinme_btn_xl w-100" t-on-click="submitCheckout" t-att-disabled="state.busy or state.geo.status === 'locating'">
            <i t-if="state.busy" class="fa fa-spinner fa-spin me-2"/><i t-else="" class="fa fa-flag-checkered me-2"/>Check Out
        </button>
    </t>

    <!-- ============================ RESULT ============================ -->
    <t t-name="checkinme_sales_activity.ScreenResult">
        <t t-set="r" t-value="state.result"/>
        <section class="o_checkinme_card text-center">
            <div t-attf-class="o_checkinme_geo_icon {{ r.location_status === 'verified' ? 'text-success' : 'text-primary' }}">
                <i t-attf-class="fa {{ state.resultKind === 'checkout' ? 'fa-flag-checkered' : 'fa-check-circle' }}"/>
            </div>
            <div class="o_checkinme_visit_name">
                <t t-if="state.resultKind === 'checkout'">Checked out</t>
                <t t-elif="state.resultKind === 'checkin'">Checked in</t>
                <t t-else="" t-esc="r.state_label"/>
            </div>
            <div class="o_checkinme_muted" t-esc="r.name"/>
            <div t-if="!isMine(r) and r.employee_name" class="o_checkinme_muted"><i class="fa fa-user me-1"/><t t-esc="r.employee_name"/></div>
            <div class="mt-3 o_checkinme_list_title" t-esc="r.partner_name or r.type_name"/>
            <div class="o_checkinme_muted"><t t-esc="r.type_name"/> &#183; <t t-esc="r.checkin_date_local"/> <t t-esc="r.checkin_time_local"/><t t-if="r.checkout_time_local"> &#8594; <t t-esc="r.checkout_time_local"/></t></div>
            <div class="mt-3">
                <span t-attf-class="o_checkinme_badge o_checkinme_badge_{{ r.location_status }}">
                    <t t-esc="r.location_status_label"/>
                    <t t-if="r.location_status === 'verified' or r.location_status === 'far'"> (<t t-esc="formatDistance(r.distance_to_partner)"/>)</t>
                </span>
            </div>
            <div class="o_checkinme_muted mt-2">
                <t t-if="r.telegram_pending"><i class="fa fa-paper-plane me-1"/>Telegram notification queued</t>
                <t t-elif="r.telegram_notified"><i class="fa fa-paper-plane me-1 text-success"/>Managers notified on Telegram</t>
            </div>
            <a t-if="r.google_maps_url" t-att-href="r.google_maps_url" target="_blank" rel="noopener" class="btn btn-link"><i class="fa fa-map me-1"/>Open in Google Maps</a>
        </section>
        <section t-if="printerReady and r.state !== 'draft'" class="o_checkinme_card o_abj_print_card">
            <button type="button" class="btn btn-outline-primary o_checkinme_btn_lg w-100" t-on-click="() => this.printSlip(r)" t-att-disabled="state.printing">
                <i t-if="isPrinting(r.id)" class="fa fa-spinner fa-spin me-2"/><i t-else="" class="fa fa-print me-2"/>Print slip
            </button>
            <button t-foreach="saleOrders(r)" t-as="order" t-key="order.id" type="button" class="btn btn-outline-secondary o_checkinme_btn_md o_abj_order_btn w-100 mt-2"
                    t-on-click="() => this.printSlip(r, order)" t-att-disabled="state.printing">
                <i t-if="isPrinting(r.id, order.id)" class="fa fa-spinner fa-spin me-2"/><i t-else="" class="fa fa-print me-2"/>
                <span class="flex-grow-1 text-start">Print <t t-esc="order.name"/></span>
                <span class="o_checkinme_muted"><t t-esc="order.state_label"/><t t-if="order.amount_total_display"> &#183; <t t-esc="order.amount_total_display"/></t></span>
            </button>
        </section>
        <div t-elif="r.state !== 'draft'" class="o_checkinme_footer">
            <a href="#" t-on-click.prevent="openSettings"><i class="fa fa-print me-1"/>Set up printer</a>
        </div>
        <div class="o_checkinme_row">
            <button t-if="r.state === 'checked_in' and isMine(r)" type="button" class="btn btn-outline-primary o_checkinme_btn_lg flex-grow-1" t-on-click="() => this.startCheckout(r)"><i class="fa fa-flag-checkered me-2"/>Check Out</button>
            <button type="button" class="btn btn-primary o_checkinme_btn_lg flex-grow-1" t-on-click="goHome"><i class="fa fa-home me-2"/>Done</button>
        </div>
        <div class="o_checkinme_footer mt-2">
            <a href="#" t-on-click.prevent="() => this.openRecord(r.id)"><i class="fa fa-pencil me-1"/>Edit in Odoo</a>
        </div>
    </t>

    <!-- ============================ HISTORY ============================ -->
    <t t-name="checkinme_sales_activity.ScreenHistory">
        <section class="o_checkinme_card">
            <div class="o_checkinme_card_title d-flex align-items-center">
                <span><i class="fa fa-history me-2"/>Recent visits</span>
                <a t-if="!printerReady" href="#" class="ms-auto o_abj_link_small" t-on-click.prevent="openSettings"><i class="fa fa-print me-1"/>Set up printer</a>
            </div>
            <div t-if="!state.history.length" class="o_checkinme_muted">No visit yet.</div>
            <div t-foreach="state.history" t-as="visit" t-key="visit.id" class="o_checkinme_list_item o_checkinme_clickable" t-on-click="() => this.openVisit(visit.id)">
                <div class="o_checkinme_list_time"><div t-esc="visit.checkin_date_local"/><div class="o_checkinme_muted" t-esc="visit.checkin_time_local"/></div>
                <div class="o_checkinme_list_main">
                    <div class="o_checkinme_list_title" t-esc="visit.partner_name or visit.type_name"/>
                    <div class="o_checkinme_muted"><t t-esc="visit.type_name"/><t t-if="visit.state !== 'draft'"> &#183; <t t-esc="visit.state_label"/></t><t t-if="visit.outcome_label"> &#183; <t t-esc="visit.outcome_label"/></t></div>
                    <span t-if="visit.state === 'draft'" class="o_checkinme_badge o_abj_row_badge o_checkinme_badge_upcoming" t-esc="visit.state_label"/>
                    <span t-else="" t-attf-class="o_checkinme_badge o_abj_row_badge o_checkinme_badge_{{ visit.location_status }}" t-esc="visit.location_status_label"/>
                </div>
                <button t-if="printerReady and visit.state !== 'draft'" type="button" class="btn btn-outline-secondary o_abj_icon_btn"
                        t-on-click.stop="() => this.printSlip(visit)" t-att-disabled="state.printing" aria-label="Print slip" title="Print slip">
                    <i t-if="isPrinting(visit.id)" class="fa fa-spinner fa-spin"/><i t-else="" class="fa fa-print"/>
                </button>
            </div>
        </section>
    </t>


    <!-- ============================ SETTINGS ============================ -->
    <t t-name="checkinme_sales_activity.ScreenSettings">
        <t t-set="ns" t-value="notificationState"/>
        <section class="o_checkinme_card o_abj_settings_notifications">
            <div class="o_checkinme_card_title d-flex align-items-center">
                <span><i class="fa fa-bell me-2"/>Notifications</span>
                <span t-attf-class="o_checkinme_badge ms-auto o_checkinme_badge_{{ ns.badge }}" t-esc="ns.label"/>
            </div>
            <div class="o_checkinme_muted mb-3">Planned visits, follow-up reminders and Odoo messages on this phone.</div>
            <div t-if="ns.hint" class="o_abj_hint mb-3" t-esc="ns.hint"/>
            <a t-if="!isNative and state.push.status === 'ios-install-first'" t-att-href="installUrl" class="btn btn-primary o_checkinme_btn_lg w-100 mb-2">
                <i class="fa fa-download me-2"/>Install page
            </a>
            <div t-if="!serverPushReady" class="o_abj_hint o_abj_hint_warning mb-3">
                <i class="fa fa-exclamation-triangle me-1"/>The server cannot send notifications to this kind of device yet. Ask your administrator.
            </div>
            <t t-if="isNative">
                <button t-if="canEnableNativePush and nativePush.permission !== 'denied'" type="button" class="btn btn-primary o_checkinme_btn_lg w-100 mb-2"
                        t-on-click="enableNativeNotifications" t-att-disabled="state.push.busy">
                    <i class="fa fa-bell me-2"/>Enable notifications
                </button>
                <button t-if="nativePush.available and nativePush.permission === 'denied'" type="button" class="btn btn-outline-primary o_checkinme_btn_md w-100 mb-2" t-on-click="openAppSettings">
                    <i class="fa fa-cog me-2"/>Open app settings
                </button>
            </t>
            <t t-elif="canEnableWebPush">
                <button t-if="state.push.status === 'prompt'" type="button" class="btn btn-primary o_checkinme_btn_lg w-100 mb-2"
                        t-on-click="enableNotifications" t-att-disabled="state.push.busy">
                    <i t-if="state.push.busy" class="fa fa-spinner fa-spin me-2"/><i t-else="" class="fa fa-bell me-2"/>Enable notifications
                </button>
                <a t-else="" href="#" class="d-block mb-2 o_abj_link_small" t-on-click.prevent="enableNotifications">Register this device again</a>
            </t>
            <button t-if="canTestPush" type="button" class="btn btn-outline-secondary o_checkinme_btn_md w-100" t-on-click="sendTestPush" t-att-disabled="state.push.testing">
                <i t-if="state.push.testing" class="fa fa-spinner fa-spin me-2"/><i t-else="" class="fa fa-paper-plane me-2"/>Send test notification
            </button>
        </section>

        <section class="o_checkinme_card o_abj_settings_printer">
            <div class="o_checkinme_card_title"><i class="fa fa-print me-2"/>Printer</div>
            <div class="o_checkinme_section_label">Connection</div>
            <div class="o_abj_options">
                <label t-foreach="transports" t-as="option" t-key="option.id" t-attf-class="o_abj_option {{ option.id === state.printer.transport ? 'active' : '' }}">
                    <input type="radio" name="abj_transport" class="form-check-input" t-att-value="option.id"
                           t-att-checked="option.id === state.printer.transport" t-on-change="() => this.chooseTransport(option.id)"/>
                    <span class="o_abj_option_text">
                        <span class="o_abj_option_label" t-esc="option.label"/>
                        <span class="o_checkinme_muted" t-esc="option.help"/>
                    </span>
                </label>
            </div>
            <t t-set="transport" t-value="currentTransport"/>
            <t t-if="transport">
                <t t-if="transport.picker === 'list'">
                    <div class="o_checkinme_section_label mt-3">Paired printers</div>
                    <div t-if="state.printerUi.loadingDevices" class="o_checkinme_muted"><i class="fa fa-spinner fa-spin me-1"/>Looking for paired devices...</div>
                    <div t-elif="!state.printerUi.devices.length" class="o_checkinme_muted">No paired printer found. Pair the printer in the phone's Bluetooth settings first.</div>
                    <button t-foreach="state.printerUi.devices" t-as="device" t-key="device.id" type="button"
                            t-attf-class="o_checkinme_list_item o_checkinme_clickable o_abj_device {{ device.id === state.printer.deviceId ? 'o_abj_selected' : '' }}"
                            t-att-aria-pressed="device.id === state.printer.deviceId ? 'true' : 'false'" t-on-click="() => this.pickPrinterDevice(device)">
                        <i t-attf-class="fa {{ device.likelyPrinter ? 'fa-print' : 'fa-bluetooth-b' }} o_checkinme_muted"/>
                        <span class="o_checkinme_list_main">
                            <span class="o_checkinme_list_title d-block" t-esc="device.name"/>
                            <span class="o_checkinme_muted d-block" t-esc="device.id"/>
                        </span>
                        <i t-if="device.id === state.printer.deviceId" class="fa fa-check-circle text-success"/>
                    </button>
                    <button type="button" class="btn btn-outline-secondary o_checkinme_btn_md w-100 mt-2" t-on-click="loadPrinterDevices" t-att-disabled="state.printerUi.loadingDevices">
                        <i class="fa fa-refresh me-2"/>Refresh the list
                    </button>
                </t>
                <t t-elif="transport.picker === 'chooser'">
                    <div class="o_checkinme_section_label mt-3">Printer</div>
                    <div class="mb-2">
                        <span t-if="state.printer.deviceName" class="o_checkinme_list_title" t-esc="state.printer.deviceName"/>
                        <span t-else="" class="o_checkinme_muted">No printer selected</span>
                    </div>
                    <button type="button" class="btn btn-outline-primary o_checkinme_btn_md w-100" t-on-click="() => this.choosePrinter()" t-att-disabled="state.printerUi.busy">
                        <i class="fa fa-search me-2"/>Choose printer
                    </button>
                    <a href="#" class="d-block mt-2 o_abj_link_small" t-on-click.prevent="() => this.choosePrinter(true)">Printer not listed? Show all devices</a>
                </t>
                <t t-elif="transport.picker === 'address'">
                    <div class="o_checkinme_section_label mt-3">Printer address</div>
                    <div class="o_checkinme_row">
                        <input type="text" inputmode="decimal" class="form-control flex-grow-1" placeholder="192.168.1.50" aria-label="IP address"
                               t-att-value="state.printer.host" t-on-change="(ev) => this.setPrinterOption('host', ev.target.value)"/>
                        <input type="number" inputmode="numeric" min="1" max="65535" class="form-control o_abj_port" aria-label="Port"
                               t-att-value="state.printer.port" t-on-change="(ev) => this.setPrinterOption('port', ev.target.value)"/>
                    </div>
                </t>

                <div class="o_checkinme_section_label mt-3">Paper width</div>
                <div class="o_abj_segmented">
                    <button t-foreach="paperWidths" t-as="paper" t-key="paper.dots" type="button"
                            t-attf-class="btn {{ paper.dots === state.printer.widthDots ? 'btn-primary' : 'btn-outline-secondary' }}"
                            t-att-aria-pressed="paper.dots === state.printer.widthDots ? 'true' : 'false'"
                            t-on-click="() => this.setPrinterOption('widthDots', paper.dots)"><t t-esc="paper.mm"/> mm</button>
                </div>

                <label t-if="transport.needsBytes" class="form-check form-switch o_abj_switch mt-3">
                    <input class="form-check-input" type="checkbox" role="switch" t-att-checked="state.printer.cut"
                           t-on-change="(ev) => this.setPrinterOption('cut', ev.target.checked)"/>
                    <span class="form-check-label">Cut the paper after printing</span>
                </label>
                <label class="form-check form-switch o_abj_switch">
                    <input class="form-check-input" type="checkbox" role="switch" t-att-checked="state.printer.autoPrint"
                           t-on-change="(ev) => this.setPrinterOption('autoPrint', ev.target.checked)"/>
                    <span class="form-check-label">Print the visit slip after each check-out</span>
                </label>
                <div t-if="transport.needsBytes" class="d-flex align-items-center gap-2 mt-2">
                    <span class="o_checkinme_muted">Copies</span>
                    <select class="form-select o_abj_copies" aria-label="Copies" t-on-change="(ev) => this.setPrinterOption('copies', ev.target.value)">
                        <option t-foreach="copiesOptions" t-as="count" t-key="count" t-att-value="count" t-att-selected="count === state.printer.copies" t-esc="count"/>
                    </select>
                </div>

                <button type="button" class="btn btn-primary o_checkinme_btn_lg w-100 mt-3" t-on-click="printTestPage" t-att-disabled="state.printerUi.busy or !printerReady">
                    <i t-if="state.printerUi.busy" class="fa fa-spinner fa-spin me-2"/><i t-else="" class="fa fa-print me-2"/>Print test page
                </button>
                <img t-if="state.printerUi.preview" class="o_abj_receipt_preview mt-3" t-att-src="state.printerUi.preview" alt="Test page"/>
            </t>
            <div t-else="" class="o_checkinme_muted mt-2">Choose how this phone reaches the receipt printer.</div>
        </section>

        <section class="o_checkinme_card o_abj_settings_app">
            <div class="o_checkinme_card_title"><i class="fa fa-mobile me-2"/>App</div>
            <div class="o_abj_kv"><span class="o_checkinme_muted">App</span><span t-esc="app.name or 'ABJ'"/></div>
            <div class="o_abj_kv"><span class="o_checkinme_muted">Running as</span><span t-esc="appModeLabel"/></div>
            <div t-if="app.server_version" class="o_abj_kv"><span class="o_checkinme_muted">Server</span><span>Odoo <t t-esc="app.server_version"/></span></div>
            <div t-if="app.company and app.company.name" class="o_abj_kv"><span class="o_checkinme_muted">Company</span><span t-esc="app.company.name"/></div>
            <div t-if="!isNative and !isStandalone" class="o_abj_hint mt-3">
                <div class="o_checkinme_list_title mb-1"><i class="fa fa-download me-1"/>Install ABJ on this phone</div>
                <div t-if="isIOS" class="o_checkinme_muted">In Safari, tap "Install page" below, then on that page tap Share &gt; Add to Home Screen. Notifications need iOS 16.4 or later.</div>
                <div t-else="" class="o_checkinme_muted">Tap "Install page" below, then "Install" on that page (or the browser menu &gt; Install app on that page).</div>
                <a t-att-href="installUrl" class="btn btn-outline-primary o_checkinme_btn_md w-100 mt-2"><i class="fa fa-download me-2"/>Install page</a>
            </div>
            <button type="button" class="btn btn-outline-secondary o_checkinme_btn_md w-100 mt-3" t-on-click="openFullOdoo">
                <i class="fa fa-th me-2"/>Open full Odoo
            </button>
            <button type="button" class="btn btn-outline-secondary o_checkinme_btn_md w-100 mt-2 o_abj_logout" t-on-click="logOut" t-att-disabled="state.loggingOut">
                <i t-if="state.loggingOut" class="fa fa-spinner fa-spin me-2"/><i t-else="" class="fa fa-sign-out me-2"/>Log out
            </button>
        </section>
    </t>

</templates>
