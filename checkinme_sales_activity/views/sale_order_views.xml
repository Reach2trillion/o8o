<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_inherit_checkinme" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.checkinme</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sales_person']/field[@name='user_id']" position="after">
                <field name="checkinme_checkin_id" options="{'no_create': True}"
                       context="{'default_partner_id': partner_id}"
                       readonly="state in ('sale', 'cancel')" groups="checkinme_sales_activity.group_checkinme_user"/>
            </xpath>
        </field>
    </record>

</odoo>
