<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================ -->
    <!-- ABJ push notifications: queue / log (system generated, read only) -->
    <!-- ================================================================ -->
    <record id="view_checkinme_push_message_list" model="ir.ui.view">
        <field name="name">checkinme.push.message.list</field>
        <field name="model">checkinme.push.message</field>
        <field name="arch" type="xml">
            <list string="Push Logs" create="0" edit="0" sample="1"
                  decoration-danger="state == 'failed'"
                  decoration-warning="state == 'partial'"
                  decoration-muted="state in ('no_device', 'pending')">
                <field name="create_date" string="Queued On"/>
                <field name="event"/>
                <field name="name"/>
                <field name="body" optional="hide"/>
                <field name="user_ids" widget="many2many_avatar_user" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'sent'"
                       decoration-warning="state == 'partial'"
                       decoration-danger="state == 'failed'"
                       decoration-muted="state in ('no_device', 'pending')"/>
                <field name="web_push_count" optional="show"/>
                <field name="native_count" optional="show"/>
                <field name="sent_date" optional="hide"/>
                <field name="error" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_checkinme_push_message_form" model="ir.ui.view">
        <field name="name">checkinme.push.message.form</field>
        <field name="model">checkinme.push.message</field>
        <field name="arch" type="xml">
            <form string="Push Notification" create="0" edit="0">
                <header>
                    <button name="action_retry" type="object" string="Send Again"
                            invisible="state not in ('failed', 'partial')"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,sent"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group name="group_message">
                            <field name="event" readonly="1"/>
                            <field name="create_date" string="Queued On" readonly="1"/>
                            <field name="sent_date" readonly="1"/>
                            <field name="url" readonly="1"/>
                            <field name="tag" readonly="1"/>
                        </group>
                        <group name="group_delivery">
                            <field name="user_ids" widget="many2many_avatar_user" readonly="1"/>
                            <field name="web_push_count" readonly="1"/>
                            <field name="native_count" readonly="1"/>
                            <field name="native_only" readonly="1"/>
                            <field name="attempt_count" readonly="1" groups="base.group_no_one"/>
                            <field name="res_model" readonly="1" groups="base.group_no_one"/>
                            <field name="res_id" readonly="1" groups="base.group_no_one"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>
                    <group name="group_body" string="Message">
                        <field name="body" nolabel="1" colspan="2" widget="text" readonly="1"/>
                    </group>
                    <group name="group_error" string="Errors" invisible="not error">
                        <field name="error" nolabel="1" colspan="2" widget="text" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_checkinme_push_message_search" model="ir.ui.view">
        <field name="name">checkinme.push.message.search</field>
        <field name="model">checkinme.push.message</field>
        <field name="arch" type="xml">
            <search string="Search Push Logs">
                <field name="name"/>
                <field name="user_ids"/>
                <field name="body"/>
                <field name="error"/>
                <filter string="Sent" name="filter_sent" domain="[('state', '=', 'sent')]"/>
                <filter string="Failed" name="filter_failed" domain="[('state', 'in', ('failed', 'partial'))]"/>
                <filter string="Pending" name="filter_pending" domain="[('state', '=', 'pending')]"/>
                <separator/>
                <filter string="Visits" name="filter_visits"
                        domain="[('event', 'in', ('planned_visit', 'followup_reminder'))]"/>
                <filter string="Team" name="filter_team" domain="[('event', 'in', ('team_checkin', 'team_checkout'))]"/>
                <filter string="Odoo Messages" name="filter_odoo" domain="[('event', '=', 'odoo_message')]"/>
                <filter string="Tests" name="filter_test" domain="[('event', '=', 'test')]"/>
                <separator/>
                <filter string="Last 7 Days" name="filter_week"
                        domain="[('create_date', '&gt;', datetime.datetime.combine(context_today() - datetime.timedelta(days=7), datetime.time(23, 59, 59)).to_utc())]"/>
                <filter string="Queued On" name="filter_date" date="create_date"/>
                <group expand="0" string="Group By">
                    <filter string="Event" name="group_event" context="{'group_by': 'event'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Day" name="group_day" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_checkinme_push_message" model="ir.actions.act_window">
        <field name="name">Push Logs</field>
        <field name="res_model">checkinme.push.message</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_checkinme_push_message_search"/>
        <field name="context">{'search_default_filter_week': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No notification sent to the ABJ app yet
            </p>
            <p>
                Every notification sent to the phones (planned visits, follow-up reminders, team check-ins,
                Odoo messages forwarded to the Android app) is logged here with the number of devices reached
                and the errors returned by the push services.
            </p>
        </field>
    </record>

    <!-- ================================================================ -->
    <!-- ABJ Android app devices (registered by the app itself)            -->
    <!-- ================================================================ -->
    <record id="view_checkinme_push_device_list" model="ir.ui.view">
        <field name="name">checkinme.push.device.list</field>
        <field name="model">checkinme.push.device</field>
        <field name="arch" type="xml">
            <list string="App Devices" create="0" edit="0" decoration-muted="not active">
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="device_name"/>
                <field name="platform"/>
                <field name="app_version" optional="show"/>
                <field name="last_seen"/>
                <field name="active" widget="boolean_toggle" readonly="0"/>
            </list>
        </field>
    </record>

    <record id="view_checkinme_push_device_form" model="ir.ui.view">
        <field name="name">checkinme.push.device.form</field>
        <field name="model">checkinme.push.device</field>
        <field name="arch" type="xml">
            <form string="App Device" create="0">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="user_id" readonly="1"/>
                            <field name="device_name" readonly="1"/>
                            <field name="platform" readonly="1"/>
                            <field name="app_version" readonly="1"/>
                        </group>
                        <group>
                            <field name="last_seen" readonly="1"/>
                            <field name="active"/>
                            <field name="blocked" invisible="not blocked"/>
                            <field name="token" readonly="1" groups="base.group_system"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_checkinme_push_device_search" model="ir.ui.view">
        <field name="name">checkinme.push.device.search</field>
        <field name="model">checkinme.push.device</field>
        <field name="arch" type="xml">
            <search string="Search App Devices">
                <field name="user_id"/>
                <field name="device_name"/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="User" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Platform" name="group_platform" context="{'group_by': 'platform'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_checkinme_push_device" model="ir.actions.act_window">
        <field name="name">App Devices</field>
        <field name="res_model">checkinme.push.device</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_checkinme_push_device_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No ABJ Android app registered yet
            </p>
            <p>
                Phones running the optional ABJ Android app appear here once the salesperson has logged in and
                allowed notifications. Archive a lost phone to stop sending it notifications. Phones using the
                installed web app (iPhone, Chrome) receive notifications through Odoo's browser subscriptions instead.
            </p>
        </field>
    </record>

</odoo>
