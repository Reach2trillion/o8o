              parent="menu_checkinme_checkins"
              action="action_checkinme_checkin_now"
              sequence="10"/>
    <menuitem id="menu_checkinme_checkin_all"
              name="All Check-ins"
              parent="menu_checkinme_checkins"
              action="action_checkinme_checkin"
              sequence="20"/>
    <menuitem id="menu_checkinme_checkin_planned"
              name="Planned Visits"
              parent="menu_checkinme_checkins"
              action="action_checkinme_checkin_planned"
              sequence="30"/>
    <menuitem id="menu_checkinme_customers"
              name="Customers"
              parent="menu_checkinme_checkins"
              action="action_checkinme_customer"
              sequence="40"/>

    <!-- Targets & KPI -->
    <menuitem id="menu_checkinme_targets"
              name="Targets &amp; KPI"
              parent="menu_checkinme_root"
              action="action_checkinme_target"
              sequence="20"/>

