<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Root -->
    <menuitem id="menu_checkinme_root"
              name="CheckinMe"
              sequence="25"
              web_icon="checkinme_sales_activity,static/description/icon.png"
              groups="checkinme_sales_activity.group_checkinme_user"/>

    <!-- Check-ins -->
    <menuitem id="menu_checkinme_checkins"
              name="Check-ins"
              parent="menu_checkinme_root"
              sequence="10"/>
    <menuitem id="menu_checkinme_checkin_now"
