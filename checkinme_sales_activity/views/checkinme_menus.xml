              parent="menu_checkinme_reporting"
              action="action_checkinme_telegram_log"
              groups="checkinme_sales_activity.group_checkinme_manager"
              sequence="30"/>

    <!-- Configuration -->
    <menuitem id="menu_checkinme_config"
              name="Configuration"
              parent="menu_checkinme_root"
              groups="checkinme_sales_activity.group_checkinme_manager"
              sequence="90"/>
    <menuitem id="menu_checkinme_activity_types"
              name="Activity Types"
              parent="menu_checkinme_config"
              action="action_checkinme_activity_type"
              sequence="10"/>
    <menuitem id="menu_checkinme_settings"
              name="Settings"
              parent="menu_checkinme_config"
              action="action_checkinme_config_settings"
              sequence="20"/>

